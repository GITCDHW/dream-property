{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/courses", "destination": "/courses" },
    { "source": "/courses/(.*)", "destination": "/courses/$1" },
    { "source": "/real-estate", "destination": "/properties" },
    { "source": "/real-estate/(.*)", "destination": "/properties/$1" }
  ]
}
